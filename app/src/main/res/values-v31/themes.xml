<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the launch splash shows the icon on the page's paper colour. -->
    <style name="Theme.PlanB" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorAccent">@color/lagoon</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
