<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the page's paper colour, so there's no white flash on launch and the bars blend in. -->
    <style name="Theme.PlanB" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorAccent">@color/lagoon</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
